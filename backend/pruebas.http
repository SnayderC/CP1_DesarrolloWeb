@baseUrl = http://localhost:3001

### 1. GET: consultar lista vacía
# Ejecutar primero, cuando habitos.json no tenga registros.
GET {{baseUrl}}/registros

### 2. POST: crear hábito válido (esperado: 201)
POST {{baseUrl}}/registros
Content-Type: application/json

{
  "nombre": "ivis",
  "email": "ivis@example.com",
  "habito": "comer frutas",
  "descripcion": "comer frutas todos los dias",
  "fecha": "2026-10-13",
  "categoria": "Salud"
}

### 3. POST: falta el nombre (esperado: 400)
POST {{baseUrl}}/registros
Content-Type: application/json

{
  "email": "ivis@example.com",
  "habito": "Leer libros",
  "descripcion": "Leer durante veinte minutos todos los dias",
  "fecha": "2026-10-15",
  "categoria": "Estudio"
}

